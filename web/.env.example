# Showup — environment
#
# Every variable here is OPTIONAL. With none of them set the app runs exactly as
# it did before Firestore existed: it reads events straight from the chain. The
# index makes the list fast and keeps it standing when a Soroban RPC read fails;
# it is never the source of truth for anything.
#
# Local: copy to .env.local (gitignored) and fill in.
# Vercel: Project Settings -> Environment Variables, same names.

# --- Client, public ------------------------------------------------------

# The host that shared links are built on. Defaults to https://showup.click.
#
# Invite and check-in links are made to be sent to other people, so they are
# NOT built from the address the page happens to be served on: an event created
# at localhost:3000 would otherwise produce an invite nobody else can open, and
# a preview deployment one that dies with the deployment. Only set this if you
# are running Showup somewhere other than showup.click.
NEXT_PUBLIC_SITE_URL=

# These ship inside the browser bundle and cannot be secret. That is fine and
# expected: firestore.rules denies every client write, so possessing them grants
# read access to data that is already public on Testnet.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# WalletConnect, from https://cloud.reown.com — create a project, copy its ID.
#
# Without it the wallet picker offers Freighter, xBull, Albedo and Hana, exactly
# as before. With it, a fifth row appears that reaches wallets living on a phone
# rather than in a browser extension.
#
# It is the only route into the Freighter mobile app: inside Freighter's own
# in-app browser the kit reports Freighter itself unavailable and expects
# WalletConnect to take over (see src/lib/kit.ts).
#
# Public on purpose. It identifies the app to the WalletConnect relay and is
# meant to ship in the browser bundle; it grants nothing on its own.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Server, secret ------------------------------------------------------
# The whole service-account JSON from Firebase Console -> Project settings ->
# Service accounts -> Generate new private key, on ONE line.
#
# This key bypasses firestore.rules completely. It must never be committed, and
# never be given a NEXT_PUBLIC_ prefix — that prefix is what decides whether
# Next.js inlines a value into the browser bundle.
#
# Pasting into Vercel turns the newlines in private_key into a literal \n;
# src/lib/firebase-admin.ts converts them back, so paste it as-is.
FIREBASE_SERVICE_ACCOUNT=
