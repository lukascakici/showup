# The generated contract bindings in packages/ are TypeScript source compiled by
# each package's own `tsc` at install time, so their devDependencies are needed to
# build the app — not just to develop it. A production install (NODE_ENV=production,
# which is what a deploy sets) otherwise omits them and the build dies with
# `tsc: command not found` before Next.js ever runs.
include=dev
