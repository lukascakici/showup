# OS
.DS_Store

# Node / Next (web/ also has its own .gitignore)
node_modules/
.next/
out/
build/
*.log

# Env
.env
.env.local
.env*.local

# Firebase service-account keys. These bypass firestore.rules completely, so the
# filename patterns Google hands them out under are blocked everywhere rather
# than trusted to be moved somewhere safe first.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
.firebase/

# Editor
.vscode/
.idea/

# Rust / Soroban (Level 2+)
contracts/target/
target/
.soroban/
.stellar/
# Regenerated on every `cargo test` run — noise, not source.
contracts/*/test_snapshots/

# Claude Code local settings
.claude/settings.local.json


/private/

/CLAUDE.md
