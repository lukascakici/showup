rules_version = '2';

// Showup — Firestore security rules.
//
// The whole policy in one sentence: anyone may read, nobody may write.
//
// Writes are not "restricted", they are impossible from any client. The only
// thing that writes here is /api/events/sync, which runs on the server with the
// Admin SDK — and the Admin SDK bypasses these rules entirely. So this file is
// the complete client-side surface, and it grants nothing.
//
// That is deliberate rather than lazy. A Firebase web config ships inside the
// browser bundle and is public by construction, so "the client has the key" is
// never a reason to trust a write. And the sync route accepts no data anyway:
// it re-reads every field from the chain, which is what makes an open write path
// unnecessary instead of merely locked down.
//
// Reads are open because everything indexed here is already public on Stellar
// Testnet. Nothing secret may ever be stored in this database — in particular
// the check-in secret, which would let someone check in without turning up and
// would defeat the entire point of the deposit.
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // The activity archive: the contract's own events, copied here while Soroban
    // RPC still had them. Rules do not cascade into subcollections, so without
    // this the catch-all below would deny the read and every archived feed would
    // come back empty.
    //
    // Same policy, for the same reason: every row was published on a public
    // ledger, and the only thing that writes them is the sync route. Note what
    // is *not* here — the check-in secret is not a contract event and must never
    // become one, so there is nothing in this collection that a reader holding
    // it could use to check in without turning up.
    match /events/{eventId}/activity/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    // Show-up records, mirrored from the reputation contract by
    // /api/records/sync. Read by the record pages and by the score gate, so that
    // showing a number is a Firestore read rather than an RPC round trip on a
    // poll.
    //
    // `write: if false` is doing more work here than anywhere else in this file.
    // A reputation somebody could edit is not a reputation — it is the whole
    // reason a score lives on a contract that only accepts writes from event
    // contracts the factory deployed. If a client could write here, the mirror
    // would become a second, editable version of a record whose entire value is
    // that nobody can edit it. Every number in this collection is a copy of one
    // the chain decided, and the contract stays the authority for every decision
    // that admits anybody or moves any money.
    match /records/{address} {
      allow read: if true;
      allow write: if false;
    }

    // The invitation-to-attendance funnel, written by /api/funnel.
    //
    // **The one collection here that reads `false` as well as writes `false`**, and
    // the exception is worth stating rather than leaving to be noticed. Everything
    // else in this database is a copy of something already public on Stellar
    // Testnet, so serving it to anybody costs nothing. These rows are visitor
    // behaviour — which invitations were opened and went nowhere — and being
    // pseudonymous is not a reason to hand them out. The funnel report is produced
    // server-side with the Admin SDK, which needs no rule here at all.
    match /funnel/{rowId} {
      allow read, write: if false;
    }

    // Display names, written by /api/names after a wallet has proved it holds the
    // address by signing a challenge transaction.
    //
    // **The only collection here holding something a person wrote**, which is why
    // it is the only one where `write: if false` is not the whole story. It is not
    // enough that a client cannot write: the *server* must not write one either
    // unless the wallet proved control, because a name sits next to somebody's
    // attendance record and in an organizer's approval queue, and a name claimed
    // for a wallet you do not hold is an impersonation the interface would perform
    // on your behalf. That check lives in the route, and this rule is what stops
    // anybody bypassing the route.
    //
    // Reads are open because a display name exists to be shown.
    match /names/{address} {
      allow read: if true;
      allow write: if false;
    }

    // The one-use nonces a wallet proof is checked against. Denied both ways: a
    // readable challenge is one an attacker can watch for, and the only thing that
    // ever needs to see one is the route that issued it.
    match /walletChallenges/{nonce} {
      allow read, write: if false;
    }

    // The conversation attached to one event's guest list.
    //
    // **Denied both ways, and that is the enforcement rather than a gap in it.**
    // The rule a reader might expect here — "allow if the caller is in this event's
    // reserved list" — would have to read the *mirrored* event document, which is a
    // snapshot of a guest list rather than the guest list. The authority on who
    // holds a spot is the event contract, and a Firestore rule cannot read a
    // contract. So membership is checked in /api/events/[id]/messages, which reads
    // `get_reserved`, `get_checked_in` and the hosts off the chain on every
    // request, and this rule is what guarantees there is no other way in.
    match /events/{eventId}/messages/{messageId} {
      allow read, write: if false;
    }

    // Anything not named above is denied outright, so a new collection cannot
    // be created by a client and quietly become writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
